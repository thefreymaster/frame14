
# (Optional) Plex server URL for full-resolution marquee posters.
# HA's media_player_proxy only returns a 200x300 thumbnail; when these are set
# the poster is fetched straight from Plex instead.
# Use the plex.direct hostname so TLS verifies — the bare IP will not:
#   https://10-0-0-5.<server-machine-id>.plex.direct:32400
PLEX_URL=

# Plex token: Plex Web → any item → ⋯ → Get Info → View XML, then copy
# X-Plex-Token from the URL.
PLEX_TOKEN=

# Assist pipeline id for the microphone button. Empty uses the preferred
# pipeline. Find it in Settings > Voice assistants, in the URL of a pipeline.
ASSIST_PIPELINE_ID=

# Optional media_player to also speak the reply on.
ASSIST_SPEAKER=
